#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&zip_temp_layer {
    excluded-positions = <
        17 18
    >;

    require-prior-idle-ms = <200>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
            layers = <0 2>;
        };

        combo_win {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp LGUI>;
            layers = <2>;
        };

        combo_right_control {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&kp RCTRL>;
            layers = <2>;
        };

    };

    macros {
        mac_mode: mac_mode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&macro_wait_time 200>, <&to 0>;
        };
        win_mode: win_mode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&macro_wait_time 200>, <&to 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        MAC_BASE {
            bindings = <
&kp Q                  &kp W                  &kp E                  &kp R                  &kp T                  &kp Y                  &kp U                  &kp I                  &kp O                  &kp P
&kp A                  &kp S                  &kp D                  &kp F                  &kp G                  &kp H                  &kp J                  &kp K                  &kp L                  &kp MINUS
&mt LEFT_SHIFT Z       &kp X                  &kp C                  &kp V                  &kp B                  &kp LANG1              &kp LANG2              &kp N                  &kp M                  &kp COMMA
&kp DOT                &mt RIGHT_SHIFT SLASH  &kp TAB                &kp LCTRL              &kp LGUI               &lt 4 SPACE            &kp BSPC               &lt 1 ENTER            &kp LGUI               &kp ESC
            >;
        };

        MAC_OPS {
            bindings = <
&kp LC(LG(SPACE))     &trans                &kp LC(UP_ARROW)      &trans                &kp F11               &trans                &kp LG(LBKT)          &kp LG(RBKT)          &kp LC(LG(F))         &kp LG(LC(Q))
&trans                &kp LC(LEFT)          &kp LS(LG(T))         &kp LC(RIGHT)         &kp LG(LS(NUMBER_3))  &kp LA(LG(ESCAPE))    &kp F2                &kp LG(M)             &trans                &trans
&trans                &kp LG(LEFT_ARROW)    &kp LC(DOWN_ARROW)    &kp LG(RIGHT_ARROW)   &kp LG(LS(NUMBER_4))  &trans                &trans                &trans                &trans                &trans
&trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &kp LG(Q)
            >;
        };

        WIN_BASE {
            bindings = <
&kp Q                  &kp W                  &kp E                  &kp R                  &kp T                  &kp Y                  &kp U                  &kp I                  &kp O                  &kp P
&kp A                  &kp S                  &kp D                  &kp F                  &kp G                  &kp H                  &kp J                  &kp K                  &kp L                  &kp MINUS
&mt LEFT_SHIFT Z       &kp X                  &kp C                  &kp V                  &kp B                  &kp LANG1              &kp LANG2              &kp N                  &kp M                  &kp COMMA
&kp DOT                &mt RIGHT_SHIFT SLASH  &kp TAB                &kp LGUI               &kp LEFT_ALT           &lt 4 SPACE            &kp BSPC               &lt 3 ENTER            &kp LCTRL              &kp ESC
            >;
        };

        WIN_OPS {
            bindings = <
&kp LG(DOT)              &trans                   &kp LG(TAB)              &trans                   &kp LG(D)                &trans                   &kp LA(LEFT)             &kp LA(RIGHT)            &kp LG(UP)               &kp LG(L)
&trans                   &kp LC(LG(LEFT_ARROW))   &kp LC(LS(T))            &kp LC(LG(RIGHT_ARROW))  &kp LG(LS(S))            &kp LC(LS(ESCAPE))       &kp F2                   &kp LG(DOWN)             &kp INSERT               &kp END
&trans                   &kp LC(HOME)             &trans                   &kp LC(END)              &kp PRINTSCREEN          &trans                   &trans                   &trans                   &trans                   &trans
&trans                   &trans                   &trans                   &trans                   &trans                   &trans                   &trans                   &trans                   &trans                   &kp LA(F4)
            >;
        };

        NUM_SYS {
            bindings = <
&kp FSLH           &kp N1             &kp N2             &kp N3             &kp MINUS          &kp PAGE_UP        &kp UP_ARROW       &kp PAGE_DOWN      &kp AT_SIGN        &kp TILDE
&kp ASTERISK       &kp N4             &kp N5             &kp N6             &kp PLUS           &kp LEFT           &kp DOWN_ARROW     &kp RIGHT          &kp LEFT_BRACKET   &kp RIGHT_BRACKET
&kp N0             &kp N7             &kp N8             &kp N9             &kp EQUAL          &trans             &kp RIGHT_SHIFT    &kp F6             &kp F7             &kp F8
&kp F9             &kp F10            &kp DOT            &trans             &trans             &trans             &kp DELETE         &mo 5              &trans             &trans
            >;
        };

        SYSTEM {
            bindings = <
&trans          &trans          &trans          &trans          &trans          &mac_mode       &win_mode       &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4
&trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
&trans          &trans          &trans          &trans          &trans          &trans          &bootloader     &trans          &trans          &trans
&bt BT_CLR      &bt BT_CLR_ALL  &trans          &trans          &trans          &trans          &trans          &mo 5           &trans          &trans
            >;
        };

        MOUSE {
            bindings = <
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &mkp MB1  &mkp MB2  &trans
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };
    };
};
